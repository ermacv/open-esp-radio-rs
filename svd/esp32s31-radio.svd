              </enumeratedValues>
            </field>
            <field>
              <name>LAST_RX_BUFFER_ENABLE_UNKNOWN</name>
              <description>Final set edge of mac_last_rxbuf_init; its narrower interaction with CSI is unknown.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
