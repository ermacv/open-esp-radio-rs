# ripgrep, and Claude Code's Grep built on it, skip these generated files in
# tree-wide searches; a search that names one of them as its path still reads
# it. Git does not read this file. See CLAUDE.md, Rules.
/crates/hardware/*/pac/raw/src/lib.rs
/crates/hardware/*/pac/src/generated.rs
/registers/*/published/*.svd
/registers/*/published/*.bindings.toml
/verification/*/facts/provenance.toml
/verification/*/facts/names/*.toml
