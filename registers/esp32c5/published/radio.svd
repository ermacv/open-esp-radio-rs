    <peripheral>
      <name>PMU_RADIO</name>
      <description>ESP32-C5 PMU fields that the PHY drives: the analog I2C power and reset
controls of the RF blocks and the immediate BB I2C power tie. Other fields
remain absent and are preserved by every field transaction.</description>
      <baseAddress>0x600B0000</baseAddress>
      <registers>
        <register>
          <name>IMM_HP_CK_POWER</name>
          <description>Immediate HP clock and analog power ties.</description>
