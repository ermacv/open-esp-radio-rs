              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CONTROL</name>
          <description>CTE antenna selection, receive-delay, IQ-selection and enable control. Bit 0 remains unassigned.</description>
          <addressOffset>0x124</addressOffset>
