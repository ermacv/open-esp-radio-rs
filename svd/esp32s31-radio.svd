            </field>
            <field>
              <name>MEMORY_INDEX</name>
              <description>Low eight bits of the PBUS command and complete CFR/gain memory index.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
