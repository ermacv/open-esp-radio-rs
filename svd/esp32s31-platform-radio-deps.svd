<?xml version="1.0" encoding="utf-8"?>
<device xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        schemaVersion="1.3"
        xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Espressif</vendor>
  <vendorID>ESP</vendorID>
  <name>ESP32S31_PLATFORM_RADIO_DEPENDENCIES</name>
  <series>ESP32-S31</series>
  <version>1.0</version>
  <description>
    Validator catalog for platform-owned registers reached by the ESP32-S31
    radio call graph. The definitions mirror the pinned official platform PAC
    SVD and do not create a second runtime owner; production code uses the
    generated esp32s31 PAC through the esp-hal integration layer.
  </description>
  <licenseText>MIT OR Apache-2.0</licenseText>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>MODEM_SYSCON</name>
      <description>SOURCE[ESP32S31_PAC_D0FB94E,S31_MODEM_SYSCON_STRUCT]. Platform-owned modem system configuration.</description>
      <baseAddress>0x20109c00</baseAddress>
      <registers>
        <register>
          <name>CLK_CONF1</name>
          <description>SOURCE[ESP32S31_PAC_D0FB94E]. Exact platform-PAC register name and access. Wi-Fi, Bluetooth and front-end clock-enable word.</description>
          <addressOffset>0x14</addressOffset><size>32</size><access>read-write</access>
        </register>
        <register>
          <name>WIFI_BB_CFG</name>
          <description>SOURCE[ESP32S31_PAC_D0FB94E,ROM_REV0_PHY_FREQUENCY_CHANNEL,BLOB_LIBPHY_PHY_BB_INIT]. Wi-Fi baseband configuration fields reached by the PHY call graph.</description>
          <addressOffset>0x18</addressOffset><size>32</size><access>read-write</access><resetValue>0x00000000</resetValue>
          <fields>
            <field><name>COLD_START_CLEAR_UNKNOWN</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>WIFI_ENABLE</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>BSS_CBW_40_DIGITAL_UNKNOWN</name><bitOffset>2</bitOffset><bitWidth>2</bitWidth></field>
            <field><name>BB_AGC_UPDATE_ENABLE_UNKNOWN</name><bitOffset>11</bitOffset><bitWidth>3</bitWidth></field>
            <field><name>MAC_BASEBAND_ENABLE_UNKNOWN</name><bitOffset>28</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
      </registers>
    </peripheral>

