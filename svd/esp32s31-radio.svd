              <bitOffset>4</bitOffset><bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PARAMETER_120_OFFSET_UNKNOWN</name>
              <description>SOURCE[ROM_REV0_PHY_AGC]; CONFIDENCE[instruction-exact-semantics-unknown]. Second update writes the low eight bits of parameter byte 0x120 plus 0x50 into bits 19:12.</description>
              <bitOffset>12</bitOffset><bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
