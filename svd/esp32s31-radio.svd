          </fields>
        </register>
        <register>
          <name>FBW_BT_FILTER_CONTROL</name>
          <description>SOURCE[ROM_REV0_PHY_FREQUENCY_CHANNEL]; CONFIDENCE[instruction-exact-multifunction]. Shared filter-bandwidth and Bluetooth-filter word independently updated by complete phy_wifi_fbw_sel and phy_bt_filter_reg.</description>
          <addressOffset>0x0874</addressOffset><size>32</size><access>read-write</access>
          <fields>
            <field><name>FBW_CLEAR_LOW_UNKNOWN</name><bitOffset>16</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>FBW_SELECT_MID_UNKNOWN</name><bitOffset>17</bitOffset><bitWidth>2</bitWidth></field>
            <field><name>FBW_CLEAR_HIGH_UNKNOWN</name><bitOffset>19</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>FBW_SELECT_HIGH_UNKNOWN</name><bitOffset>20</bitOffset><bitWidth>2</bitWidth></field>
