        <register>
          <name>BASEBAND_INIT_7CA8</name>
          <description>Complete phy_bb_reg_init sets bit 20.</description>
          <addressOffset>0x7CA8</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
