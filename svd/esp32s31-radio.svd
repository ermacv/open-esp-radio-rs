            <field>
              <name>MINIMUM_POWER_INDEX</name>
              <description>Complete hal_set_tx_min_pwr(-11) writes signed six-bit value 0x35.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
