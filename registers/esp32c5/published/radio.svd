              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRIGGER_FLOW_HIGH_OPAQUE</name>
              <description>Opaque: meaning not established. The complete HAL returns four additional high bitmap bits whose bounded ordinary-queue meaning remains unresolved.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>COMPLETE_CLEAR</name>
          <description>Project-assigned name. Preserved-image acknowledgement for ordinary queue completion bits.</description>
          <addressOffset>0x58</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>QUEUE_0</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>QUEUE_1</name>
              <description>Project-assigned name.</description>
