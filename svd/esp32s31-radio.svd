                <enumeratedValue><name>PERIF</name><value>0x69</value></enumeratedValue>
                <enumeratedValue><name>BIAS</name><value>0x6a</value></enumeratedValue>
                <enumeratedValue><name>TXRF</name><value>0x6b</value></enumeratedValue>
                <enumeratedValue><name>DIG_REG</name><value>0x6d</value></enumeratedValue>
