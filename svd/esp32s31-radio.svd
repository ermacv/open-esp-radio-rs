    <peripheral>
      <name>SHARED_BASEBAND_TX_TIMING</name>
      <description>One physical baseband timing word reached by the common BTBB initializer.
The named vendor leaf carries a historical Zigbee prefix, but the current
evidence proves only the exact shared initialization transaction and does not
grant protocol-exclusive ownership.</description>
      <baseAddress>0x20102010</baseAddress>
      <registers>
        <register>
          <name>AUXILIARY_TX_ON_DELAY</name>
          <description>The complete named setter replaces bits 16:26 with an encoded argument image and preserves every other bit.</description>
