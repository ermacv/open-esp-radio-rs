# Finite WDEVPWR hard-ISR boundary. Cause meanings and task-side policy remain
# opaque until independently qualified; this slice proves only STATUS/CLEAR.
default-disposition not-yet-ported
default-protocol wifi

function libpp hal_pwr_interrupt_get_event
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_pac::generated::hal_pwr_interrupt_get_event
binding v1
rust-probe open_libpp_power_irq_trace_hal_pwr_interrupt_get_event
compare-return true
effect-contract exact-effects-v1
effect mmio-read 32 0x2010d8bc required

function libpp hal_pwr_interrupt_clr_event
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_pac::generated::hal_pwr_interrupt_clr_event
binding v1
rust-probe open_libpp_power_irq_trace_hal_pwr_interrupt_clr_event
effect-contract exact-effects-v1
effect mmio-write 32 0x2010d8c0 required
