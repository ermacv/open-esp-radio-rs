#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="$(cd -- "$script_dir/../../.." && pwd)"
binary="$workspace_root/target/workbench/vendor-binary-workbench"

if [[ ! -x "$binary" ]]; then
    echo "error: optimized workbench binary is missing: $binary" >&2
    echo "build it first with: cargo build --profile workbench -p open-radio-vendor-binary-workbench --bin vendor-binary-workbench" >&2
    exit 2
fi

limit_backend="${VENDOR_WORKBENCH_LIMIT_BACKEND:-auto}"
if [[ "$limit_backend" != "auto" && "$limit_backend" != "systemd" && "$limit_backend" != "prlimit" ]]; then
    echo "error: VENDOR_WORKBENCH_LIMIT_BACKEND must be auto, systemd, or prlimit" >&2
    exit 2
fi

if [[ "$limit_backend" != "prlimit" ]] \
    && command -v systemd-run >/dev/null 2>&1 \
    && command -v systemctl >/dev/null 2>&1 \
    && systemctl --user show-environment >/dev/null 2>&1; then
    exec systemd-run --user --pipe --wait --collect --quiet \
        --working-directory="$PWD" \
        --property=MemoryMax=1G \
        --property=MemorySwapMax=0 \
        --property=RuntimeMaxSec=15min \
        -- "$binary" "$@"
fi

if [[ "$limit_backend" == "systemd" ]]; then
    echo "error: requested user systemd resource scope is unavailable" >&2
    exit 2
fi

if command -v prlimit >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
    # RLIMIT_AS bounds RAM plus swap-backed address space and is therefore
    # stricter than an RSS-only limit. timeout supplies the wall-clock bound.
    exec prlimit --as=1073741824 -- \
        timeout --signal=TERM --kill-after=10s 15m \
        "$binary" "$@"
fi

echo "error: a user systemd scope or both prlimit and timeout are required" >&2
echo "refusing to run artifact-wide analysis without hard resource limits" >&2
exit 2
