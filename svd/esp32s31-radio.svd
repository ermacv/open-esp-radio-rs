      <registers>
        <register>
          <dim>16</dim>
          <dimIncrement>0x10</dimIncrement>
          <dimIndex>0-15</dimIndex>
          <name>ENTRY%s</name>
          <description>BTDM scheduler initialization clears bits 0..19 while preserving bits 20..31. No semantic meaning is assigned to either region.</description>
