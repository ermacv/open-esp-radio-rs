  <vendor>Espressif</vendor>
  <vendorID>ESP</vendorID>
  <name>ESP32S31_RADIO</name>
  <series>ESP32-S31</series>
  <version>0.3</version>
  <description>
    Recovered ESP32-S31 radio clock, reset, power, PHY-PBus and PHY-I2C subset.
    Unknown fields are omitted; OPAQUE and UNKNOWN names describe
    instruction-level evidence without assigning an unproven hardware meaning.
  </description>
  <licenseText>MIT OR Apache-2.0</licenseText>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
