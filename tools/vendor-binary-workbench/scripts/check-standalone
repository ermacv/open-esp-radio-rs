#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source_root="$(cd -- "$script_dir/.." && pwd)"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/vendor-binary-workbench-standalone.XXXXXX")"
trap 'rm -rf -- "$scratch"' EXIT

cp -a -- "$source_root/." "$scratch/"

cat >>"$scratch/Cargo.toml" <<'EOF'

[workspace]
members = [
    ".",
    "crates/analysis-model",
    "crates/backend-riscv",
    "crates/contracts",
    "crates/execution-model",
    "crates/register-model",
    "crates/semantics",
]
resolver = "3"

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.97.1"
license = "MIT OR Apache-2.0"
repository = "https://github.com/ermacv/vendor-binary-workbench"

[workspace.lints.rust]
unsafe_op_in_unsafe_fn = "deny"

[workspace.lints.clippy]
debug_assert_with_mut_call = "deny"

[profile.workbench]
inherits = "dev"
opt-level = 3
EOF

cargo metadata --manifest-path "$scratch/Cargo.toml" --no-deps --format-version 1 \
    >"$scratch/metadata.json"
jq -e --arg root "$scratch/" '
    all(
        .packages[].dependencies[] | select(.path != null) | .path;
        startswith($root)
    )
' "$scratch/metadata.json" >/dev/null || {
    echo "error: extracted Workbench contains a path dependency outside its workspace" >&2
    exit 1
}

cargo generate-lockfile --manifest-path "$scratch/Cargo.toml"
cargo check --manifest-path "$scratch/Cargo.toml" --workspace --all-targets --locked

echo "standalone Workbench workspace is self-contained" >&2
