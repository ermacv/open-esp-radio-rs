            <field><name>BT_FILTER_MODE_UNKNOWN</name><bitOffset>23</bitOffset><bitWidth>2</bitWidth></field>
            <field><name>BT_FILTER_ENABLE_UNKNOWN</name><bitOffset>25</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>CHANNEL_TX_OFFSET_CONTROL</name>
          <description>SOURCE[ROM_REV0_PHY_FREQUENCY_CHANNEL]; CONFIDENCE[instruction-exact-semantics-from-symbol]. Low channel-offset field shared by complete phy_mac_tx_chan_offset and phy_bb_cbw_chan_cfg.</description>
          <addressOffset>0x4400</addressOffset><size>32</size><access>read-write</access>
          <fields><field><name>CHANNEL_OFFSET_UNKNOWN</name><bitOffset>0</bitOffset><bitWidth>4</bitWidth></field></fields>
        </register>
