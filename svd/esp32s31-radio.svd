              <description>High address bit during frequency-memory writes; independently cleared then set by complete phy_freq_module_resetn.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHANNEL_SWITCH_PULSE</name>
              <description>Complete phy_freq_chan_en_sw sets bit 19, delays one microsecond, then clears it.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MEMORY_WRITE_PULSE</name>
              <description>Complete phy_freq_i2c_mem_write sets then clears bit 20 after publishing data.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REGISTER_MODE_UNKNOWN</name>
              <description>Complete phy_freq_reg_init replaces bits 29:22 with its two input nibbles; the electrical encoding is unknown.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
