          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>STATE_LOW_20</name>
              <description>Low twenty bits cleared independently in every observed entry.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>CLEARED</name>
                  <description>The only reviewed image written by the recovered scheduler-table transaction.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
