# Finite register leaves used by the production RX descriptor-ring owner.
# Descriptor memory ownership, recycle policy and the bounded async reload
# transaction remain Rust composition responsibilities.
default-disposition not-yet-ported
default-protocol wifi

function libpp hal_mac_rx_disable
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_registers::generated::hal_mac_rx_disable
binding v1
rust-probe open_libpp_rx_trace_hal_mac_rx_disable
effect-contract exact-effects-v1
effect mmio-read 32 0x20104080 required
effect mmio-write 32 0x20104080 required

function libpp hal_mac_rx_enable
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_registers::generated::hal_mac_rx_enable
binding v1
rust-probe open_libpp_rx_trace_hal_mac_rx_enable
effect-contract exact-effects-v1
effect mmio-read 32 0x20104080 required
effect mmio-write 32 0x20104080 required

function libpp hal_mac_rx_read_rxdscrlast
