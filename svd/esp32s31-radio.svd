            </field>
          </fields>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_BITMAP_LOW</name>
          <description>Shared extra-SoftAP low receive/reorder bitmap staging word, cleared when installing or removing an entry.</description>
          <addressOffset>0xEB4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_BITMAP_HIGH</name>
          <description>Shared extra-SoftAP high receive/reorder bitmap staging word, cleared when installing or removing an entry.</description>
          <addressOffset>0xEB8</addressOffset>
