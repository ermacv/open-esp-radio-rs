              <description>SOURCE[ROM_REV0_PHY_CLOCK_FORCE]; CONFIDENCE[instruction-exact-pair-semantics]. phy_set_txclk_en writes both bits as a pair; individual clock identities are unknown.</description>
              <bitOffset>16</bitOffset><bitWidth>2</bitWidth>
            </field>
            <field><name>BUSY</name><bitOffset>31</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>READ_RESULT_0</name>
          <description>SOURCE[ROM_REV0_PHY_PBUS]; CONFIDENCE[instruction-exact-packed-windows]. Selector 1 reads window 0 for non-path-1 operations, including the RX-DCO path, and window 1 for path 1.</description>
