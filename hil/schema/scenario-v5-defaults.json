{
  "?bluetooth": {
    "$kind": {
      "secure-gatt": {
        "irq_sampling": "every-snapshot",
        "shutdown": "bond-load-failure"
      }
    }
  },
  "?wifi": {
    "datapath": {
      "l1_cache_counters": false,
      "placement": "split-radio-network",
      "rx_checksum": "software",
      "rx_continuation": "immediate-software-probe",
      "tx_buffer": "owned-sram-promotion",
      "tx_udp_checksum": "software"
    },
    "workload": {
      "$kind": {
        "access-point": {
          "?link": {
            "guard_interval": "any"
          },
          "clients": {
            "$kind": {
              "laptop": {
                "laptop_phy": "ht"
              },
              "laptop-and-openwrt": {
                "laptop_phy": "ht"
              },
              "openwrt": {
                "fixed_guard_interval": false
              }
            },
            "kind": "laptop"
          },
          "independent_air_monitor": false,
          "probe_load": false,
          "scheduler": "disabled",
          "security": "wpa2-personal",
          "traffic": {
            "$kind": {
              "icmp": {
                "maximum_lost": 0
              },
              "udp": {
                "criteria": {
                  "exact_delivery": false
                }
              },
              "udp-multi-client": {
                "criteria": {
                  "exact_delivery": false
                },
                "secondary": {}
              }
            }
          }
        },
        "monitor-capture": {
          "link": {
            "guard_interval": "any"
          }
        },
        "role": {
          "link": {
            "guard_interval": "any"
          }
        },
        "station-access-point": {
          "independent_air_monitor": false,
          "link": {
            "guard_interval": "any"
          }
        },
        "station-access-point-reconnect": {
          "link": {
            "guard_interval": "any"
          }
        },
        "station-ap-absence": {
          "initially_absent": false,
          "link": {
            "guard_interval": "any"
          }
        },
        "station-ap-loss": {
          "link": {
            "guard_interval": "any"
          }
        },
        "station-icmp": {
          "criteria": {
            "maximum_lost": 0,
            "require_no_beacon_loss": false
          },
          "link": {
            "guard_interval": "any"
          }
        },
        "station-reconnect": {
          "link": {
            "guard_interval": "any"
          }
        },
        "station-tcp": {
          "criteria": {
            "require_no_beacon_loss": false
          },
          "link": {
            "guard_interval": "any"
          }
        },
        "station-udp": {
          "criteria": {
            "exact_delivery": false,
            "require_no_beacon_loss": false
          },
          "fixed_fixture_guard_interval": false,
          "link": {
            "guard_interval": "any"
          },
          "observation": {
            "independent_air_monitor": false,
            "openwrt_tx_monitor": false
          }
        }
      }
    }
  },
  "repetitions": 1
}
