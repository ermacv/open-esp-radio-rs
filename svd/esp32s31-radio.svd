        <register>
          <name>BF_TIMING_CONTROL</name>
          <description>Seven ordered RMWs in complete hal_init_bf. Complete dbg_read_rx_misc supplies the beamforming field names through its WDEVBEAMFORMCONF decoder. Complete dbg_disable_report_cbf independently proves the write polarity of HE_BEAM_ENABLE bit 20. Complete esp_test_get_csi_dump_cfg supplies the more specific RXBFRPTO_MS name for bits 7:1.</description>
          <addressOffset>0xC30</addressOffset>
          <size>0x20</size>
