    <peripheral>
      <name>PHY_FREQUENCY_CHANNEL_ORACLE</name>
      <description>Frequency-memory, hardware channel-switch, NRX and channel-bandwidth
        registers recovered from complete finite ROM/blob bodies. Names retain
