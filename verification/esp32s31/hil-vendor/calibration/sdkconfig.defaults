CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Full calibration on every boot: no calibration data is loaded or stored.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
CONFIG_ESP_PHY_RF_CAL_FULL=y
# The HIL flash layout: the application occupies ota_0 of the shared table.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../platform/esp32s31/partitions/applications.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# The HIL serial device is the USB-Serial/JTAG console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Equal sources give an equal image, so the board journal identifies it.
CONFIG_APP_REPRODUCIBLE_BUILD=y
# The Wi-Fi client keeps no configuration in the shared NVS partition.
CONFIG_ESP_WIFI_NVS_ENABLED=n
