          <size>0x20</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>OCTETS_0_TO_3</name>
              <description>The complete low word assembled from input bytes zero through three.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
