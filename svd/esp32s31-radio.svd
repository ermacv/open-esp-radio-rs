                </range>
              </writeConstraint>
            </field>
            <field>
              <name>CONFIG_FORCE_ZERO_8</name>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SHARED_INIT_IMAGE_10_20</name>
              <description>The complete shared receive initializer replaces bits 10:20 with the finite image 0x79C.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>11</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>2047</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>SHARED_RX_INIT_IMAGE_0</name>
          <description>The complete shared receive initializer replaces two disjoint positional fields with finite images while preserving every other bit.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>POSITIONAL_IMAGE_13_20</name>
