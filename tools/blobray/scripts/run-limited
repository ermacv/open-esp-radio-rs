#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="$(cd -- "$script_dir/../../.." && pwd)"
binary="${BLOBRAY_BINARY:-$workspace_root/target/blobray/blobray}"

if [[ ! -f "$binary" || ! -x "$binary" ]]; then
    echo "error: optimized blobray binary is missing: $binary" >&2
    echo "set BLOBRAY_BINARY to an executable built with --profile blobray" >&2
    echo "default host build: cargo build --profile blobray -p blobray-esp32s31 --bin blobray" >&2
    exit 2
fi

# Both launch backends must execute the same caller-selected file. A local
# bare filename must not become a PATH lookup; systemd needs an absolute path.
binary="$(cd -- "$(dirname -- "$binary")" && pwd)/$(basename -- "$binary")"

limit_backend="${BLOBRAY_LIMIT_BACKEND:-auto}"
report_usage="${BLOBRAY_REPORT_USAGE:-0}"
if [[ "$limit_backend" != "auto" && "$limit_backend" != "systemd" && "$limit_backend" != "watchdog" ]]; then
    echo "error: BLOBRAY_LIMIT_BACKEND must be auto, systemd, or watchdog" >&2
    exit 2
fi
if [[ "$report_usage" != "0" && "$report_usage" != "1" ]]; then
    echo "error: BLOBRAY_REPORT_USAGE must be 0 or 1" >&2
    exit 2
fi

# systemd owns the analyzed process as a sibling of this wrapper, so external
# tools such as /usr/bin/time report only systemd-run's RSS. The watchdog owns
# one private process session and can account the complete descendant tree.
if [[ "$report_usage" == "1" && "$limit_backend" == "auto" ]]; then
    limit_backend="watchdog"
fi

if [[ "$limit_backend" != "watchdog" ]] \
    && command -v systemd-run >/dev/null 2>&1 \
    && command -v systemctl >/dev/null 2>&1 \
    && systemctl --user show-environment >/dev/null 2>&1 \
    && systemd-run --user --pipe --wait --collect --quiet \
        --property=MemoryMax=1G \
        --property=MemorySwapMax=0 \
        --property=RuntimeMaxSec=10s \
        -- /usr/bin/true >/dev/null 2>&1; then
    exec systemd-run --user --pipe --wait --collect --quiet \
        --working-directory="$PWD" \
        --property=MemoryMax=1G \
        --property=MemorySwapMax=0 \
        --property=RuntimeMaxSec=15min \
        -- "$binary" "$@"
fi

if [[ "$limit_backend" == "systemd" ]]; then
    echo "error: requested user systemd resource scope is unavailable" >&2
    exit 2
fi

if [[ ! -r /proc/self/status ]]; then
    echo "error: the RSS watchdog requires Linux /proc" >&2
    exit 2
fi
for command in ps awk setsid; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "error: the RSS watchdog requires $command" >&2
        exit 2
    fi
done

memory_limit_kib=1048576
deadline_seconds=900
grace_seconds=10
reason=""
peak_rss_kib=0
session_pids=""
rss_kib=0

sample_session() {
    local session_id="$1"
    local processes sample
    processes="$(ps -e -o pid=,sid=,rss=)" || return 1
    sample="$(awk -v session="$session_id" '
        NF == 0 { next }
        NF != 3 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ {
            invalid = 1; next
        }
        { process_count++ }
        $2 == session { total += $3; pids = pids " " $1 }
        END { if (invalid || !process_count) exit 1; printf "%.0f %s\n", total + 0, pids }
    ' <<< "$processes")" || return 1
    read -r rss_kib session_pids <<< "$sample"
}

# A private session keeps descendant accounting and termination correct even
# after an intermediate worker exits and its children are reparented.
setsid -- "$binary" "$@" &
child=$!
started=$SECONDS

session_alive() {
    # The leader may still be entering its private session on the first sample.
    [[ -n "$session_pids" ]] || kill -0 "$child" 2>/dev/null
}

terminate_session() {
    local signal="$1"
    local session_id="$2"
    # Cover the original process group even when process enumeration failed.
    # Previously sampled members also cover workers in their own groups.
    kill -s "$signal" -- "-$session_id" 2>/dev/null || true
    kill -s "$signal" "$child" 2>/dev/null || true
    local pid
    for pid in $session_pids; do
        kill -s "$signal" "$pid" 2>/dev/null || true
    done
}

# Invoked by the signal traps below; covered by the process shutdown tests.
# shellcheck disable=SC2329
stop_on_signal() {
    reason="received $1"
    terminate_session TERM "$child"
}
trap 'stop_on_signal INT' INT
trap 'stop_on_signal TERM' TERM

while [[ -z "$reason" ]]; do
    if ! sample_session "$child"; then
        reason="could not inspect process-session resource usage"
        terminate_session TERM "$child"
        break
    fi
    session_alive || break
    if (( rss_kib > peak_rss_kib )); then
        peak_rss_kib="$rss_kib"
    fi
    if (( rss_kib > memory_limit_kib )); then
        reason="process-tree RSS exceeded 1 GiB (observed ${rss_kib} KiB)"
        terminate_session TERM "$child"
        break
    fi
    if (( SECONDS - started >= deadline_seconds )); then
        reason="runtime exceeded 15 minutes"
        terminate_session TERM "$child"
        break
    fi
    sleep 0.1
done

if [[ -n "$reason" ]]; then
    grace_started=$SECONDS
    while (( SECONDS - grace_started < grace_seconds )); do
        # A failed sample cannot establish that the session exited. Escalate
        # using the last known members and original process group instead.
        sample_session "$child" || break
        session_alive || break
        sleep 0.1
    done
    terminate_session KILL "$child"
fi

set +e
wait "$child"
status=$?
set -e
trap - INT TERM

if [[ -n "$reason" ]]; then
    echo "error: blobray resource watchdog stopped the command: $reason" >&2
    echo "peak RSS: ${peak_rss_kib} KiB" >&2
    exit 137
fi

if [[ "$report_usage" == "1" ]]; then
    echo "blobray usage: elapsed=${SECONDS}s peak_session_rss=${peak_rss_kib} KiB" >&2
fi

exit "$status"
