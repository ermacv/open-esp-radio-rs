    <peripheral>
      <name>WIFI_MAC_HE_INIT_SUFFIX</name>
      <description>Complete hardware-visible hal_he_init suffix after dbg_read_tx_power, including all reached leaves. It contains 163 ordered writes/RMWs plus the two multi-BSSID guard reads.</description>
