              <description>Project-assigned name.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TIMEOUT_QUEUE_1</name>
              <description>Project-assigned name.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TIMEOUT_QUEUE_2</name>
              <description>Project-assigned name.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TIMEOUT_QUEUE_3</name>
              <description>Project-assigned name.</description>
              <bitOffset>19</bitOffset>
