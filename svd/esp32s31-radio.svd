        </register>
        <register>
          <dim>3</dim>
          <dimIncrement>0x8</dimIncrement>
          <dimIndex>0-2</dimIndex>
          <name>SLOT%s_HIGH</name>
          <description>Bytes four and five of the selected six-byte value in bits 0..15; the complete write clears bits 16..31.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>OCTETS_4_TO_5</name>
              <description>Input bytes four and five packed in little-endian order.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
