          <addressOffset>0x158</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x08000000</resetValue>
          <fields>
            <field>
              <name>XPD_CKGEN5G</name>
              <description>Power the 5 GHz clock generator.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XPD_TC5G_I2C</name>
              <description>Power the analog I2C of the 5 GHz transceiver.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XPD_RX5G_I2C</name>
              <description>Power the analog I2C of the 5 GHz receiver.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PERIF_I2C_RSTB</name>
              <description>Release the peripheral analog I2C from reset when set.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XPD_PERIF_I2C</name>
              <description>Power the peripheral analog I2C.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XPD_TXRF_I2C</name>
              <description>Power the analog I2C of the RF transmitter.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XPD_RFRX_PBUS</name>
              <description>Power the RF receiver PBus.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XPD_CKGEN_I2C</name>
              <description>Power the analog I2C of the clock generator.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XPD_PLL_I2C</name>
              <description>Power the analog I2C of the PLL.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
