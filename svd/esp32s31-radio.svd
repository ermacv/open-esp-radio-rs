      <name>WIFI_MAC_RX_END_STATE</name>
      <description>Receive-end state word returned by the complete hal_mac_rx_get_end_state and hal_mac_rx_get_end_info leaves.</description>
      <baseAddress>0x201040A8</baseAddress>
