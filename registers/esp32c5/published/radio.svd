              <description>Tie the BB analog I2C power high; ESP-IDF declares the field write-trigger.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RF_PWC</name>
