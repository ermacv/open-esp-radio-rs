# Every inventory function resolves through these fail-closed defaults. A new
# vendor symbol is therefore visible as not-yet-ported instead of disappearing
# from the report. Protocol remains unknown until a reviewed family rule or an
# exact function entry classifies it.
default-disposition not-yet-ported
default-protocol unknown

# Protocol classification is independent of implementation status. Keep the
# shared PHY/RF functions unknown until their actual cross-protocol ownership
# is established; names alone are not enough to call them Wi-Fi.
protocol-prefix rom phy_wifi_ wifi
protocol-prefix archive phy_wifi_ wifi
protocol-prefix rom phy_11p_ wifi
protocol-prefix archive phy_11p_ wifi
protocol-prefix rom phy_bt_ bluetooth
protocol-prefix archive phy_bt_ bluetooth
protocol-prefix rom bt_ bluetooth
protocol-prefix archive bt_ bluetooth
protocol-prefix rom phy_ble_ ble
protocol-prefix archive phy_ble_ ble
protocol-prefix rom ble_ ble
protocol-prefix archive ble_ ble
protocol-prefix rom phy_coex_ coex
protocol-prefix archive phy_coex_ coex
protocol-prefix rom coex_ coex
protocol-prefix archive coex_ coex
protocol-prefix rom phy_154_ ieee802154
protocol-prefix archive phy_154_ ieee802154

# Effect Contract v1 pilot: exact finite MMIO leaf. The contract classifies
# every vendor effect; a new read, write, call, delay, or state edge fails
# closed instead of being ignored by a normalizer.
function rom phy_disable_agc
disposition direct
protocol shared
rust-component open_esp_radio_esp32s31_hal::phy_agc::set_enabled
binding v1
vendor-revision esp32s31-eco0-rom
vendor-artifact-sha256 a52ad7513deb656a910a5740125f1cce2c7941f11ce57213b7b43aea93d5ab87
vendor-artifact-sha256 d01bde81d9b3806e37ef1d9ac3b58af4f5b3d91eeef4f44d20e79d6a9f227542
rust-probe open_phy_trace_disable_agc
effect-contract exact-effects-v1
effect mmio-read 32 0x20107030 required
effect mmio-write 32 0x20107030 required

# The complete cold-registration graph already has a single Rust owner and
# successful hardware evidence. These entries describe implementation only:
# until a semantic transition contract is executable, they remain
# IMPLEMENTED-UNQUALIFIED and do not satisfy the completion gate.
function archive register_chipv7_phy
disposition replaced-by-composition
protocol shared
rust-component open_esp_radio_esp32s31_phy::phy_register::PhyRegisterTransition
hil-evidence docs/hil/2026-07-31-driver-repo-he20-bidirectional.md
blocked-by archive phy_bb_init

function archive phy_rf_init
disposition state-transition
protocol shared
rust-component open_esp_radio_esp32s31_phy::phy_cold::PhyRfColdInit
hil-evidence docs/hil/2026-07-31-driver-repo-he20-bidirectional.md
semantic-contract esp32s31-rf-init

function archive phy_bb_init
disposition state-transition
protocol shared
rust-component open_esp_radio_esp32s31_phy::phy_bb::PhyBbInitTransition
hil-evidence docs/hil/2026-07-31-driver-repo-he20-bidirectional.md
blocked-by archive phy_bt_tx_gain_init

function archive phy_chip_set_chan
disposition state-transition
protocol shared
rust-component open_esp_radio_esp32s31_phy::phy_channel::PhyChipChannelTransition
hil-evidence docs/hil/2026-07-31-driver-repo-he20-bidirectional.md
semantic-contract esp32s31-channel

function archive phy_bt_txdc_cal_new
disposition state-transition
protocol bluetooth
rust-component open_esp_radio_esp32s31_phy::phy_bluetooth::PhyBluetoothTxDcTransition
semantic-contract esp32s31-bluetooth-txdc

function archive phy_bt_tx_pwctrl_init
disposition state-transition
protocol bluetooth
rust-component open_esp_radio_esp32s31_phy::phy_bluetooth::PhyBluetoothTxPowerTransition
semantic-contract esp32s31-bluetooth-tx-power

function archive phy_txdc_cal_pwdet_init
disposition state-transition
protocol shared
rust-component open_esp_radio_esp32s31_phy::phy_bluetooth::PhyBluetoothTxDcPwdetTransition
semantic-contract esp32s31-bluetooth-txdc-pwdet
