protocol wifi
rust-component open_esp_radio_esp32s31_registers::generated::hal_mac_rx_read_rxdscrlast
binding v1
rust-probe open_libpp_rx_trace_hal_mac_rx_read_rxdscrlast
compare-return true
effect-contract exact-effects-v1
effect mmio-read 32 0x2010408c required

