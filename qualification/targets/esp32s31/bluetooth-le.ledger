# Machine-checked qualification roots for the source-only ESP32-S31 LE Controller.
# Every current hardware and protocol gap is deliberate; no capability in this
# initial ledger is on-air ready.
ledger-version 2
target esp32s31-bluetooth-le
verification-project verification/vendor/targets/esp32s31/vendor-project.toml
vendor-evidence-index verification/vendor/targets/esp32s31/evidence/vendor-evidence.json
require-capability cold-ownership
require-capability clock-reset-prerequisite
require-capability controller-initialization
require-capability common-phy-baseband
require-capability interrupt-runtime
require-capability controller-memory-lists
require-capability hci-handoff-storage
require-capability hci-bootstrap
require-capability hci-bootstrap-worker
require-capability packet-dataplane
require-capability le-link-layer
require-capability typed-hci-controller
require-capability async-controller-runtime
require-capability trouble-host-integration
require-capability coexistence
require-capability powered-teardown

