#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="$(cd -- "$script_dir/../../.." && pwd)"
binary="$workspace_root/target/workbench/vendor-binary-workbench"

if [[ ! -x "$binary" ]]; then
    echo "error: optimized workbench binary is missing: $binary" >&2
    echo "build it first with: cargo build --profile workbench -p open-radio-vendor-binary-workbench --bin vendor-binary-workbench" >&2
    exit 2
fi

limit_backend="${VENDOR_WORKBENCH_LIMIT_BACKEND:-auto}"
if [[ "$limit_backend" != "auto" && "$limit_backend" != "systemd" && "$limit_backend" != "watchdog" ]]; then
    echo "error: VENDOR_WORKBENCH_LIMIT_BACKEND must be auto, systemd, or watchdog" >&2
    exit 2
fi

if [[ "$limit_backend" != "watchdog" ]] \
    && command -v systemd-run >/dev/null 2>&1 \
    && command -v systemctl >/dev/null 2>&1 \
    && systemctl --user show-environment >/dev/null 2>&1 \
    && systemd-run --user --pipe --wait --collect --quiet \
        --property=MemoryMax=1G \
        --property=MemorySwapMax=0 \
        --property=RuntimeMaxSec=10s \
        -- /usr/bin/true >/dev/null 2>&1; then
    exec systemd-run --user --pipe --wait --collect --quiet \
        --working-directory="$PWD" \
        --property=MemoryMax=1G \
        --property=MemorySwapMax=0 \
        --property=RuntimeMaxSec=15min \
        -- "$binary" "$@"
fi

if [[ "$limit_backend" == "systemd" ]]; then
    echo "error: requested user systemd resource scope is unavailable" >&2
    exit 2
fi

if [[ ! -r /proc/self/status ]]; then
    echo "error: the RSS watchdog requires Linux /proc" >&2
    exit 2
fi

memory_limit_kib=1048576
deadline_seconds=900
grace_seconds=10
reason=""
peak_rss_kib=0

"$binary" "$@" &
child=$!
started=$SECONDS

terminate_child() {
    local signal="$1"
    if kill -0 "$child" 2>/dev/null; then
        kill -s "$signal" "$child" 2>/dev/null || true
    fi
}

trap 'terminate_child TERM' INT TERM

while kill -0 "$child" 2>/dev/null; do
    rss_kib="$(awk '/^VmRSS:/ { print $2 }' "/proc/$child/status" 2>/dev/null || true)"
    rss_kib="${rss_kib:-0}"
    if (( rss_kib > peak_rss_kib )); then
        peak_rss_kib="$rss_kib"
    fi
    if (( rss_kib > memory_limit_kib )); then
        reason="RSS exceeded 1 GiB (observed ${rss_kib} KiB)"
        terminate_child TERM
        break
    fi
    if (( SECONDS - started >= deadline_seconds )); then
        reason="runtime exceeded 15 minutes"
        terminate_child TERM
        break
    fi
    sleep 0.1
done

if [[ -n "$reason" ]]; then
    grace_started=$SECONDS
    while kill -0 "$child" 2>/dev/null && (( SECONDS - grace_started < grace_seconds )); do
        sleep 0.1
    done
    terminate_child KILL
fi

set +e
wait "$child"
status=$?
set -e
trap - INT TERM

if [[ -n "$reason" ]]; then
    echo "error: workbench resource watchdog stopped the command: $reason" >&2
    echo "peak RSS: ${peak_rss_kib} KiB" >&2
    exit 137
fi

exit "$status"
