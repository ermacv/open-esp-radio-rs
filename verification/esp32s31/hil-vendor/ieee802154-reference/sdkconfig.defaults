CONFIG_IDF_TARGET="esp32s31"
CONFIG_IEEE802154_ENABLED=y
# Only protocol lines reach the host; driver and boot logs stay quiet.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
# The digest depends only on the sources.
CONFIG_APP_REPRODUCIBLE_BUILD=y
# The stand reaches the device through its USB Serial/JTAG port, which
# carries the console in both directions.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
