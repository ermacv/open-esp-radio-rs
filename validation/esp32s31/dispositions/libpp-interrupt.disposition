# Qualification manifest for the first libpp vertical slice. The generated
# PAC leaves are composed by the source-owned MAC ISR replacement; the root
# adapter checks the selected vendor control path against compiled Rust.
default-disposition not-yet-ported
default-protocol wifi

function libpp hal_mac_interrupt_get_event
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_registers::generated::hal_mac_interrupt_get_event
binding v1
rust-probe open_libpp_trace_hal_mac_interrupt_ret_get_event
compare-return true
effect-contract exact-effects-v1
effect mmio-read 32 0x20104c48 required

function libpp hal_mac_interrupt_clr_event
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_registers::generated::hal_mac_interrupt_clr_event
binding v1
rust-probe open_libpp_trace_hal_mac_interrupt_ret_clr_event
compare-return true
effect-contract exact-effects-v1
effect mmio-write 32 0x20104c4c required

function libpp wDev_ProcessFiq
disposition replaced-by-composition
protocol wifi
rust-component open_esp_radio_esp32s31_wifi_lmac::irq::handle_mac_irq
binding v1
rust-probe open_libpp_trace_wdev_process_fiq_mac_slice
driver-adapter esp32s31-wdev-process-fiq-mac-slice-v1
effect-contract exact-effects-v1
effect mmio-read 32 0x20104c48 required
effect mmio-write 32 0x20104c4c required
effect platform-provided-service embassy-mac-work-wakeup required
effect published-event mac-rx-success required
effect published-event mac-tx-complete required
effect published-event mac-tx-timeout required
effect published-event mac-collision required
effect initialization-prerequisite wifi-bss-color-interrupts-disabled required
effect initialization-prerequisite wifi-power-interrupts-disabled required
