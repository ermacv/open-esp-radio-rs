              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BASEBAND_INIT_7CD0</name>
          <description>Complete phy_bb_reg_init sets both nibbles to 0xf; complete phy_btbb_wifi_bb_cfg2 preserves low bit two, sets the other low bits and sets the high nibble.</description>
          <addressOffset>0x7CD0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
