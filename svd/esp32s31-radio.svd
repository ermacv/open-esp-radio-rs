              <name>AC_EMPTY_SINGLE_BSR</name>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PREAC_NO_RESOURCE_ENABLE_BSR</name>
              <description>Complete dbg_read_bsr_info names this PREAC_NORES_ENA_BSR.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>QOS_DATA_UPDATE_BSR</name>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IGNORE_VALID_TB</name>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IGNORE_VALID_EDCA</name>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TB_NO_RESOURCE_CONTINUE_TX</name>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AUTO_ACK_ALLOW_ERSU</name>
              <description>Complete dbg_read_rx_misc names the bit AUTOACK_ALLOW_ERSU. Complete hal_he_set_ersu clears it for a nonzero HE Operation ER-SU argument and sets it for zero; the PAC preserves that counterintuitive instruction-exact polarity.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HE_RESPONSE_ACK</name>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TB_CARE_CCA_AND_NAV</name>
              <description>Complete dbg_tb_ignore_cca_enable clears this bit and logs "tb ignore CCA and NAV" for a nonzero argument; it sets the bit and logs "tb care CCA and NAV" for zero.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BSR_ENABLE</name>
              <description>Complete hal_he_bsr_init sets this bit; complete hal_he_bsr_ctrl controls it.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
