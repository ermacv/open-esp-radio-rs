              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>QUEUE_2</name>
              <description>Project-assigned name.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>QUEUE_3</name>
