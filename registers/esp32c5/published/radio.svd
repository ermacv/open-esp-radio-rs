    <peripheral>
      <name>IEEE802154_INTERRUPT_ROUTE</name>
      <description>The CPU interrupt-matrix word for ESP32-C5 modem source 12 (ZB_MAC). This
source-specific view is retained with the IEEE 802.15.4 owner and publishes
only the generated field readers needed to prove that a polled or validation
transaction starts with the CPU route detached.</description>
      <baseAddress>0x60010030</baseAddress>
      <registers>
        <register>
          <name>CORE0_ROUTE</name>
          <description>Project-assigned name. Destination and security routing for ZB_MAC.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MAP</name>
              <description>Project-assigned name. CPU-interrupt destination selected for the peripheral source.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>BITS_6_7_OPAQUE</name>
              <description>Opaque: meaning not established. Bits the vendor declares reserved, retained solely so reset-state observation cannot erase an unexpected nonzero value.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>PASS_IN_SEC</name>
              <description>Project-assigned name. Secure-world pass-through selection for the peripheral source.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BITS_9_31_OPAQUE</name>
              <description>Opaque: meaning not established. Bits the vendor declares reserved, retained solely so reset-state observation cannot erase an unexpected nonzero value.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>23</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MODEM_ETM</name>
      <description>ESP32-C5 modem event-task matrix at MODEM_BASE + 0x8800. The public
IEEE 802.15.4 driver names the channel-enable, set and clear words and the
per-channel event/task pair at an eight-byte stride from 0x18, and programs
channels zero and one. Other channels and identifiers remain absent and no
reset values are claimed.</description>
      <baseAddress>0x600A8800</baseAddress>
      <registers>
        <register>
          <name>CHANNEL_ENABLE</name>
          <description>Project-assigned name. Channel-enable status word. The IEEE 802.15.4 driver reads it to decide whether a channel must be disabled.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>CH0</name>
              <description>Project-assigned name. Enabled state of channel 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CH1</name>
              <description>Project-assigned name. Enabled state of channel 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CHANNEL_ENABLE_SET</name>
          <description>Project-assigned name. Channel-enable set word. The IEEE 802.15.4 driver reads it and writes it back with the selected channel bit added; the effect of writing other bits is not reviewed.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CH0</name>
              <description>Project-assigned name. Enable request of channel 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CH1</name>
              <description>Project-assigned name. Enable request of channel 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CHANNEL_ENABLE_CLEAR</name>
          <description>Project-assigned name. Channel-enable clear word. The IEEE 802.15.4 driver reads it and writes it back with the selected channel bit added, only when that channel is enabled.</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CH0</name>
              <description>Project-assigned name. Disable request of channel 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CH1</name>
              <description>Project-assigned name. Disable request of channel 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>0x8</dimIncrement>
          <dimIndex>0-1</dimIndex>
          <name>CH%s_EVENT</name>
          <description>Project-assigned name. Complete event identifier monitored by the selected channel.</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ID</name>
              <description>Project-assigned name. Event identifier written as a complete word.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>IEEE802154_TIMER1_OVERFLOW</name>
                  <value>58</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IEEE802154_TIMER0_OVERFLOW</name>
                  <value>59</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>0x8</dimIncrement>
          <dimIndex>0-1</dimIndex>
          <name>CH%s_TASK</name>
          <description>Project-assigned name. Complete task identifier triggered when the selected channel's event occurs.</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ID</name>
              <description>Project-assigned name. Task identifier written as a complete word.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>IEEE802154_ED_TRIG_TX</name>
                  <value>65</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IEEE802154_RX_START</name>
                  <value>66</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IEEE802154_TX_START</name>
                  <value>69</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MODEM_SYSCON_RADIO</name>
      <description>ESP32-C5 MODEM_SYSCON clock gates and resets at MODEM_BASE + 0x9C00 driven
by the vendor modem clock devices of the IEEE 802.15.4 module (802154_MAC,
BT_I154_COMMON_BB, ETM, BT_APB) and its MAC reset. Other fields remain absent
and are preserved by every field transaction.</description>
      <baseAddress>0x600A9C00</baseAddress>
      <registers>
        <register>
          <name>CLK_CONF</name>
          <description>Modem clock selectors and protocol clock gates.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00200002</resetValue>
          <fields>
            <field>
              <name>CLK_ETM_EN</name>
              <description>Enable the modem ETM clock.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_ZB_APB_EN</name>
              <description>Enable the IEEE 802.15.4 APB clock.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_ZBMAC_EN</name>
              <description>Enable the IEEE 802.15.4 MAC clock.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_MODEM_SEC_APB_EN</name>
              <description>Enable the modem-security APB clock.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MODEM_RST_CONF</name>
          <description>Modem protocol reset lines.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RST_ZBMAC_APB</name>
              <description>Hold the IEEE 802.15.4 APB interface in reset.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RST_ZBMAC</name>
              <description>Hold the IEEE 802.15.4 MAC in reset.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLK_CONF1</name>
          <description>Wi-Fi, front-end and Bluetooth clock gates.</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLK_BT_APB_EN</name>
              <description>Enable the Bluetooth APB clock.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_BTBB_EN</name>
              <description>Enable the baseband clock shared by Bluetooth LE and IEEE 802.15.4.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MODEM_LPCON_SHARED_CLOCK</name>
      <description>ESP32-C5 MODEM_LPCON clock gate at MODEM_BASE + 0xF000 driven by the vendor
COEXIST modem clock device, and the power-state map of the analog I2C master
clock. Other fields remain absent and are preserved by every field
transaction.</description>
      <baseAddress>0x600AF000</baseAddress>
      <registers>
        <register>
          <name>CLK_CONF</name>
          <description>Low-power modem clock gates.</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLK_COEX_EN</name>
              <description>Enable the coexistence clock.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_I2C_MST_EN</name>
              <description>Enable the analog register I2C master clock; the platform keeps its reference count.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLK_CONF_POWER_ST</name>
          <description>PMU power states in which each low-power modem clock domain runs.</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLK_I2C_MST_ST_MAP</name>
              <description>PMU power states in which the analog register I2C master clock runs, one bit
per state (SLEEP, MODEM, ACTIVE). On ESP32-C5 v1.0 the MODEM bit must stay
clear: it survives the HP-system reset of a USB Serial/JTAG RTS pulse, after
which the ROM boots into UART/SDIO download (docs/hardware-errata.md,
ESP32-C5 rev 1.0 USB Serial/JTAG reset erratum).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>I2C_ANA_MST</name>
      <description>ESP32-C5 analog register I2C master at MODEM_BASE + 0xF800: the two command
hosts, the read-mask word and the host-selection field that the libphy
analog-register leaves drive. Other fields remain absent and are preserved by
every field transaction.</description>
      <baseAddress>0x600AF800</baseAddress>
      <registers>
        <register>
          <name>I2C0_CTRL</name>
          <description>Host-0 analog-register command word.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SLAVE_ADDR</name>
              <description>Project-assigned name. Analog block code.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>SLAVE_REG_ADDR</name>
              <description>Project-assigned name. Register address inside the analog block.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>DATA</name>
              <description>Project-assigned name. Byte written, or the byte read once the command completes.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>READ_WRITE</name>
              <description>Project-assigned name. Set for a write command, clear for a read command.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSY</name>
              <description>Project-assigned name. Set while the host executes a command.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>START_OR_RESET</name>
              <description>Project-assigned name. Set by every libphy command publication, above the public 25-bit control field.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>I2C1_CTRL</name>
          <description>Host-1 analog-register command word.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SLAVE_ADDR</name>
              <description>Project-assigned name. Analog block code.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>SLAVE_REG_ADDR</name>
              <description>Project-assigned name. Register address inside the analog block.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>DATA</name>
              <description>Project-assigned name. Byte written, or the byte read once the command completes.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>READ_WRITE</name>
              <description>Project-assigned name. Set for a write command, clear for a read command.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSY</name>
              <description>Project-assigned name. Set while the host executes a command.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>START_OR_RESET</name>
              <description>Project-assigned name. Set by every libphy command publication, above the public 25-bit control field.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ANA_CONF1</name>
          <description>Analog block read-mask word, published complete before every read.</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0000002D</resetValue>
          <fields>
            <field>
              <name>READ_MASK_COMPLEMENT_LOW</name>
              <description>Project-assigned name. Low 24 bits of the complemented one-hot read mask of the block being read.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>16777215</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>READ_MASK_COMPLEMENT_HIGH</name>
              <description>Project-assigned name. High byte of the complemented read mask; the libphy publication sets it to 0xFF.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>ANA_CONF2</name>
          <description>Analog block host-selection word.</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000004</resetValue>
          <fields>
            <field>
              <name>PHY_HOST_MAP</name>
              <description>Project-assigned name. Host-selection field that phy_get_i2c_hostid_ replaces on every analog-register access while preserving the other bits.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>13</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>REVIEWED_RADIO_MAP</name>
                  <value>6593</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PARALLEL_INITIALIZATION_MAP</name>
                  <value>518</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
