    <peripheral>
      <name>PHY_FECOEX_RECOVERED</name>
      <description>Sparse FECOEX words absent from the public platform PAC.</description>
      <baseAddress>0x20100000</baseAddress>
      <registers>
        <register>
          <name>BT_COEX_PTI_CONFIG</name>
