    <peripheral>
      <name>PHY_CLOCK_ORACLE</name>
      <description>OPAQUE PHY clock-gate
        registers recovered from complete no-call ROM/blob leaves.</description>
      <baseAddress>0x20100000</baseAddress>
      <registers>
        <register>
          <name>FE_CLOCK_GATE_OPAQUE</name>
          <description>ROM writes 0x1e7 to open and the blob writes zero to close.</description>
          <addressOffset>0x400</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>STATE</name>
              <description>Complete observed front-end clock-gate images; constituent gate meanings remain unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>CLOSED</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OPEN</name>
                  <value>487</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TABLE_MEMORY_INDEX_SOURCE</name>
          <description>Shared word contains the table-memory base index and the complete phy_force_pwr_index controls.</description>
          <addressOffset>0x408</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FORCED_POWER_INDEX</name>
              <description>Complete phy_force_pwr_index replaces bits 22:17 with the low six bits of its second argument.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>63</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>FORCE_POWER_ENABLE</name>
              <description>Complete phy_force_pwr_index replaces bit 23 with the low bit of its first argument.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BASE_INDEX</name>
              <description>Eight-bit table-memory base index; the complete front-end initializer writes 0xa0.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>FE_BB_CLOCK_CONTROL_OPAQUE</name>
          <description>ROM sets bits 1:0 and the blob clears them.</description>
          <addressOffset>0x800</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ROM_FE_BB_ENABLE_UNKNOWN</name>
              <description>Two-bit open/close mask; individual meanings are unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>CLOSED</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OPEN</name>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PHY_CALIBRATION_CLOCK_UNKNOWN</name>
              <description>The phy_bb_init parent sets bit 2 before calibration; the individual hardware meaning remains unknown.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BB_CLOCK_GATE_OPAQUE</name>
          <description>ROM writes all ones to open and the blob writes zero to close.</description>
          <addressOffset>0x7C80</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>STATE</name>
              <description>Complete observed baseband clock-gate images; constituent gate meanings remain unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>CLOSED</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OPEN</name>
                  <value>4294967295</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_STA_BEACON_FILTER</name>
