              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DELAY_RX_AOD</name>
              <bitOffset>6</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DELAY_RX_AOA</name>
              <bitOffset>14</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ANTENNA_FORCE</name>
              <bitOffset>22</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ANTENNA_FORCE_ON</name>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CTE_ENABLE</name>
              <description>Complete ble_bb_cte_set_cte_en replaces bit 31 with the caller's Boolean image.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
