        <register>
          <name>INTERRUPT_1_STATUS</name>
          <description>WDEV_INT1_STATUS diagnostic snapshot read by complete print_isr_regs.</description>
          <addressOffset>0xBEC</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>EVENTS</name>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
