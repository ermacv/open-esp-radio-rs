                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HAL_INIT_SECOND_BYTE_UNKNOWN</name>
              <description>Complete hal_init replaces bits 15:8 with one through a separate RMW.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
