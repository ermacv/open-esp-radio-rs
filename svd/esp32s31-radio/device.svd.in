      <source id="BLOB_LIBPHY_PHY_DC_MEM_CLR">_oracles/libphy.a sha256 51497819736295c9b33d6775495dade4c6fb39db887edfe095608c670d9ae223; complete phy_reg.o phy_dc_mem_clr body, size 0x1c</source>
