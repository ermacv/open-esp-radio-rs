            </field>
          </fields>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_START_SEQUENCE</name>
          <description>Shared extra-SoftAP staging word carrying the twelve-bit starting sequence.</description>
          <addressOffset>0xEB0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SEQUENCE</name>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>4095</maximum>
                </range>
