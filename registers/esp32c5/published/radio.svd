        <register>
          <name>CTRL</name>
          <description>SAR ADC control word.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x40038240</resetValue>
          <fields>
            <field>
              <name>SARADC2_PWDET_DRV</name>
