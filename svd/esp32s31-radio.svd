            <field><name>SHIFT_LOW_OR_INIT_HIGH_UNKNOWN</name><bitOffset>24</bitOffset><bitWidth>5</bitWidth></field>
            <field><name>SHIFT_HIGH_UNKNOWN</name><bitOffset>29</bitOffset><bitWidth>3</bitWidth></field>
          </fields>
        </register>
        <register>
