                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>MEMORY_ADDRESS_LOW_UNKNOWN</name>
              <description>Low ten bits of the eleven-bit address selected by phy_freq_i2c_mem_write.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>10</bitWidth>
