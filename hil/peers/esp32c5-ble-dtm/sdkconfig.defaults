CONFIG_IDF_TARGET="esp32c5"
# The vendor BLE Controller alone, reached over VHCI in RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
# The LE Receiver, Transmitter and Test End commands exist only with DTM.
CONFIG_BT_LE_DTM_ENABLED=y
# Only protocol lines reach the host; driver and boot logs stay quiet.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
# The stand reaches the peer through its USB Serial/JTAG port, which carries
# the console in both directions.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Equal sources give an equal image, so the board journal identifies it.
CONFIG_APP_REPRODUCIBLE_BUILD=y
