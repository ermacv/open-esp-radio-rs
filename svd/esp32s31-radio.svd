    <peripheral>
      <name>WIFI_MAC_ANTENNA_INIT</name>
      <description>Complete hal_attenna_init transaction. The misspelled vendor symbol first visits eight reverse-stride queue/vector words, then updates one common word.</description>
      <baseAddress>0x201042B0</baseAddress>
      <registers>
        <register>
          <name>COMMON_CONTROL</name>
          <description>Complete leaf clears bit 2, then sets bit 5 through a separate fresh-read RMW.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COMMON_CLEAR_UNKNOWN</name>
              <description>Cleared by the penultimate RMW of the complete leaf.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>COMMON_ENABLE_UNKNOWN</name>
              <description>Set by the final RMW of the complete leaf.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x7C</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <name>BANK_CONTROL%s</name>
          <description>Lower four unique words of the eight-word antenna traversal, at 0x201051ac..0x20105320. The upper four words are the canonical WIFI_MAC_TX_QUEUE_VECTOR.LENGTH_CONTROL array, whose decoded antenna fields occupy the same bits.</description>
          <addressOffset>0xEFC</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FIRST_CLEAR_UNKNOWN</name>
              <description>Cleared for all eight words in the first reverse traversal.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SECOND_CLEAR_UNKNOWN</name>
              <description>Cleared in the first RMW of each word in the second reverse traversal.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>THIRD_CLEAR_UNKNOWN</name>
              <description>Cleared in the third RMW of each word in the second reverse traversal.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BANK_ENABLE_UNKNOWN</name>
              <description>Set in the middle RMW of each word in the second reverse traversal.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_TSF_STATUS</name>
      <description>Station TSF activity status recovered from the complete no-call hal_is_sta_tsf_active leaf. The instruction body proves the address and bit geometry but not the hardware transition rules.</description>
      <baseAddress>0x2010D80C</baseAddress>
      <registers>
        <register>
          <name>STATUS</name>
          <description>Complete hal_is_sta_tsf_active returns bit zero.</description>
