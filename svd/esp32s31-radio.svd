              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PBUS_COMMAND_BIT_9</name>
              <description>PBUS command bit 9; CFR and gain-memory preserve it.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TX_CFR_COMMIT</name>
              <description>TX-CFR entry commit pulse.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
