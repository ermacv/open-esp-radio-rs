      <source id="BLOB_LIBPHY_PHY_CFR_CONTROL">_oracles/libphy.a sha256 51497819736295c9b33d6775495dade4c6fb39db887edfe095608c670d9ae223; complete phy_reg.o phy_iccfr_en size 0x2c, phy_force_iccfr size 0x7a and phy_config_hccfr size 0x38</source>
