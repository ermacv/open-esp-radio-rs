          <addressOffset>0x08</addressOffset><size>32</size><access>read-write</access><dim>4</dim><dimIncrement>0x10</dimIncrement><dimIndex>0-3</dimIndex>
          <fields>
            <field><name>TIMEOUT</name><bitOffset>0</bitOffset><bitWidth>12</bitWidth></field>
            <field><name>CONTENTION_WINDOW</name><bitOffset>12</bitOffset><bitWidth>10</bitWidth></field>
