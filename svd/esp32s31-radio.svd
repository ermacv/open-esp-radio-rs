    <peripheral>
      <name>BT_V3_2_CTE</name>
      <description>Bluetooth direction-finding control words recovered from complete, independently
named CTE accessors in the ESP32-S31 vendor baseband library. Only fields touched
by those accessors are described; untouched bits remain unassigned.</description>
      <baseAddress>0x20102000</baseAddress>
      <registers>
        <register>
          <name>LC_8M_CONTROL</name>
