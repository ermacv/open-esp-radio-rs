#!/bin/sh
set -eu

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export LC_ALL

HOSTAPD=/usr/local/libexec/open-radio-hostapd
HOSTAPD_PID=/run/open-radio-hostapd.pid
DNSMASQ_PID=/run/open-radio-dnsmasq.pid
CTRL_DIR=/run/open-radio-hostapd
STATE_DIR=/run/open-radio-net
PHY_STATE="$STATE_DIR/phy"
MAC_STATE="$STATE_DIR/mac"
RFKILL_ID_STATE="$STATE_DIR/rfkill-id"
RFKILL_SOFT_STATE="$STATE_DIR/rfkill-soft"
WPA_PID="$STATE_DIR/wpa-supplicant.pid"
WPA_CONFIG="$STATE_DIR/wpa-supplicant.conf"
AP_CONFIG="$STATE_DIR/hostapd.conf"
WPA_CTRL=/run/open-radio-wpa-control

usage() {
    echo "usage: open-radio-net {capabilities|identity|ap|client|monitor|monitor-1|monitor-6|monitor-11|observer|managed|stop|status|usb-reset|kernel-log}" >&2
    exit 64
}

test "$#" -eq 1 || usage

stop_pidfile() {
    pidfile=$1
    if test ! -f "$pidfile"; then
        return
    fi
    pid=$(/bin/cat "$pidfile")
    case "$pid" in
        ''|*[!0-9]*) ;;
        *)
            /bin/kill "$pid" 2>/dev/null || true
            # A new wpa_supplicant must not race the previous daemon while it
            # is still releasing the same nl80211 interface. This previously
            # produced an intermittent twenty-second scan with zero frames
            # transmitted by the client, while the target AP kept beaconing.
            attempts=0
            while /bin/kill -0 "$pid" 2>/dev/null && test "$attempts" -lt 100; do
                attempts=$((attempts + 1))
                /bin/sleep 0.02
            done
            ;;
    esac
    /bin/rm -f "$pidfile"
}

stop_radio_services() {
    stop_pidfile "$WPA_PID"
    stop_pidfile "$DNSMASQ_PID"
    stop_pidfile "$HOSTAPD_PID"
    /usr/bin/iw dev mon0 del 2>/dev/null || true
    /usr/bin/wpa_cli -g /run/wpa_supplicant/global interface_remove wlan0 \
        >/dev/null 2>&1 || true
    /usr/bin/ip link set wlan0 down 2>/dev/null || true
    /usr/bin/ip address flush dev wlan0 2>/dev/null || true
    /bin/rm -f "$WPA_CONFIG" "$AP_CONFIG"
    /bin/rm -f "$CTRL_DIR/hostapd.log"
    /bin/rm -rf "$WPA_CTRL"
}

take_network_manager_ownership() {
    # A reconnect between `ip link set down` and the nl80211 type/channel
    # transaction produces EBUSY and leaves a nominal monitor interface
    # without a channel context. The HIL helper, rather than a background
    # desktop policy, owns wlan0 until the explicit `managed` action.
    /usr/bin/nmcli device set wlan0 managed no 2>/dev/null || true
}

remember_wifi_identity() {
    if test ! -e /sys/class/net/wlan0/phy80211; then
        return
    fi
    phy=$(/usr/bin/basename "$(/usr/bin/readlink /sys/class/net/wlan0/phy80211)")
    mac=$(/bin/cat /sys/class/net/wlan0/address)
    /bin/mkdir -p "$STATE_DIR"
    /usr/bin/printf '%s\n' "$phy" >"$PHY_STATE"
    /usr/bin/printf '%s\n' "$mac" >"$MAC_STATE"
}

acquire_wifi_rfkill() {
    phy=$(/bin/cat "$PHY_STATE")
    if test ! -s "$RFKILL_ID_STATE" || test ! -s "$RFKILL_SOFT_STATE"; then
        /bin/rm -f "$RFKILL_ID_STATE" "$RFKILL_SOFT_STATE"
        for entry in /sys/class/rfkill/rfkill*; do
            test -e "$entry/type" || continue
            test "$(/bin/cat "$entry/type")" = wlan || continue
            test "$(/bin/cat "$entry/name")" = "$phy" || continue
            id=${entry##*/rfkill}
            /usr/bin/printf '%s\n' "$id" >"$RFKILL_ID_STATE"
            /bin/cat "$entry/soft" >"$RFKILL_SOFT_STATE"
            break
        done
    fi
    test -s "$RFKILL_ID_STATE"
    test -s "$RFKILL_SOFT_STATE"
    id=$(/bin/cat "$RFKILL_ID_STATE")
    case "$id" in ''|*[!0-9]*) return 1;; esac
    entry="/sys/class/rfkill/rfkill$id"
    test "$(/bin/cat "$entry/type")" = wlan
    test "$(/bin/cat "$entry/name")" = "$phy"
    test "$(/bin/cat "$entry/hard")" = 0
    /usr/bin/rfkill unblock "$id"
    test "$(/bin/cat "$entry/soft")" = 0
}

restore_wifi_rfkill() {
    if test ! -s "$RFKILL_ID_STATE" || test ! -s "$RFKILL_SOFT_STATE"; then
        return
    fi
    id=$(/bin/cat "$RFKILL_ID_STATE")
    initial=$(/bin/cat "$RFKILL_SOFT_STATE")
    phy=$(/bin/cat "$PHY_STATE")
    case "$id" in ''|*[!0-9]*) return 1;; esac
    case "$initial" in 0|1) ;; *) return 1;; esac
    entry="/sys/class/rfkill/rfkill$id"
    test "$(/bin/cat "$entry/type")" = wlan
    test "$(/bin/cat "$entry/name")" = "$phy"
    if test "$initial" = 1; then
        /usr/bin/rfkill block "$id"
    else
        /usr/bin/rfkill unblock "$id"
    fi
    test "$(/bin/cat "$entry/soft")" = "$initial"
    /bin/rm -f "$RFKILL_ID_STATE" "$RFKILL_SOFT_STATE"
}

restore_managed_interface() {
    if test -e /sys/class/net/wlan0; then
        /usr/bin/iw dev wlan0 set type managed
        return
    fi
    test -s "$PHY_STATE"
    test -s "$MAC_STATE"
    phy=$(/bin/cat "$PHY_STATE")
    mac=$(/bin/cat "$MAC_STATE")
    test -e "/sys/class/ieee80211/$phy"
    /usr/bin/iw phy "$phy" interface add wlan0 type managed addr "$mac"
}

recreate_managed_interface() {
    # Repeated target-AP stop/start qualification keeps the Intel PHY alive
    # across many independent peer epochs. Merely killing wpa_supplicant and
    # toggling IFF_UP eventually leaves an iwlwifi firmware peer context that
    # reports authentication attempts to cfg80211 but puts no usable frame on
    # air. Recreating only the managed wdev releases that fixture-owned state;
    # the physical adapter, MAC identity and AP-under-test remain unchanged.
    if test -e /sys/class/net/wlan0; then
        /usr/bin/iw dev wlan0 del
    fi
    restore_managed_interface
    # NetworkManager's `managed no` property belongs to the old netdev. The
    # recreated wdev is a new device and can otherwise be claimed immediately
    # by the desktop's global supplicant, which was observed reconnecting it
    # to the normal uplink while the private HIL supplicant remained scanning.
    take_network_manager_ownership
    /usr/bin/wpa_cli -g /run/wpa_supplicant/global interface_remove wlan0 \
        >/dev/null 2>&1 || true
    /usr/bin/ip address flush dev wlan0 2>/dev/null || true
}

# A fixed stdin protocol: no caller-provided paths or hostapd directives.
read_ap_profile() {
    IFS= read -r ap_ssid_hex
    IFS= read -r ap_passphrase
    IFS= read -r ap_country
    IFS= read -r ap_channel
    IFS= read -r ap_width
    IFS= read -r ap_he
    IFS= read -r ap_address
    IFS= read -r ap_dhcp
    IFS= read -r ap_noscan
    case "$ap_noscan" in 0) ;; 1) case "$ap_width" in HT40+|HT40-) ;; *) return 64;; esac;; *) return 64;; esac
    case "$ap_ssid_hex" in ''|*[!0-9a-f]*) return 64;; esac
    test "${#ap_ssid_hex}" -le 64
    test "$(( ${#ap_ssid_hex} % 2 ))" -eq 0
    test "${#ap_passphrase}" -ge 8
    test "${#ap_passphrase}" -le 63
    case "$ap_passphrase" in *"$(printf '\r')"*) return 64;; esac
    case "$ap_country" in [A-Z][A-Z]) ;; *) return 64;; esac
    case "$ap_channel" in [1-9]|1[0-3]) ;; *) return 64;; esac
    case "$ap_width" in
        HT20) ap_ht='[SHORT-GI-20]';;
        HT40+) test "$ap_channel" -le 9; ap_ht='[HT40+][SHORT-GI-20][SHORT-GI-40]';;
        HT40-) test "$ap_channel" -ge 5; ap_ht='[HT40-][SHORT-GI-20][SHORT-GI-40]';;
        *) return 64;;
    esac
    case "$ap_he" in 0) ;; 1) test "$ap_width" = HT20;; *) return 64;; esac
    # Validate the small network argument grammar before touching the radio.
    # ip/dnsmasq additionally validate address and mask semantics.
    case "$ap_address" in ''|*[!0-9./]*) return 64;; esac
    case "$ap_dhcp" in ''|*[!0-9.,]*) return 64;; esac
    printf '%s\n' "$ap_address" | /usr/bin/awk -F/ 'NF != 2 || $2 < 1 || $2 > 30 {exit 1} {n=split($1,a,"."); if(n!=4) exit 1; for(i=1;i<=4;i++) if(a[i]=="" || a[i]>255) exit 1}'
    printf '%s\n' "$ap_dhcp" | /usr/bin/awk -F, 'NF != 3 {exit 1} {for(j=1;j<=3;j++) {n=split($j,a,"."); if(n!=4) exit 1; for(i=1;i<=4;i++) if(a[i]=="" || a[i]>255) exit 1}}'
}

write_ap_profile() {
    printf 'interface=wlan0\ndriver=nl80211\nctrl_interface=%s\nctrl_interface_group=network\n' "$CTRL_DIR"
    printf 'ssid2=%s\ncountry_code=%s\nhw_mode=g\nchannel=%s\n' "$ap_ssid_hex" "$ap_country" "$ap_channel"
    printf 'ieee80211n=1\nht_capab=%s\nieee80211ax=%s\nwmm_enabled=1\n' "$ap_ht" "$ap_he"
    printf 'noscan=%s\nht_coex=1\n' "$ap_noscan"
    printf 'auth_algs=1\nwpa=2\nwpa_passphrase=%s\nwpa_key_mgmt=WPA-PSK\nrsn_pairwise=CCMP\n' "$ap_passphrase"
}

start_ap() {
    read_ap_profile
    take_network_manager_ownership
    remember_wifi_identity
    acquire_wifi_rfkill
    stop_radio_services
    restore_managed_interface
    /usr/bin/ip link set wlan0 up
    /bin/mkdir -p "$STATE_DIR"
    /bin/chmod 0700 "$STATE_DIR"
    umask 077
    write_ap_profile >"$AP_CONFIG"
    /bin/rm -rf "$CTRL_DIR"
    /bin/mkdir -m 0750 "$CTRL_DIR"
    /bin/chown root:network "$CTRL_DIR"
    # Daemonization otherwise discards the scan/coexistence decision made
    # after startup. Keep it readable by the fixture owner until cleanup.
    : >"$CTRL_DIR/hostapd.log"
    /bin/chown root:network "$CTRL_DIR/hostapd.log"
    /bin/chmod 0640 "$CTRL_DIR/hostapd.log"
    # The installed hostapd can omit CONFIG_DEBUG_FILE. Capture its foreground
    # output instead of relying on -f (which can silently do nothing).
    /usr/bin/setsid /usr/bin/stdbuf -oL -eL "$HOSTAPD" -d "$AP_CONFIG" \
        </dev/null >"$CTRL_DIR/hostapd.log" 2>&1 &
    printf '%s\n' "$!" >"$HOSTAPD_PID"
    # The Rust owner attaches to hostapd's control socket and waits for ENABLED.
    /usr/bin/ip address add "$ap_address" dev wlan0
    /usr/bin/dnsmasq \
        --conf-file=/dev/null \
        --interface=wlan0 \
        --bind-interfaces \
        --dhcp-range="$ap_dhcp,1h" \
        --pid-file="$DNSMASQ_PID"
}

start_monitor() {
    frequency=$1
    width=$2
    take_network_manager_ownership
    remember_wifi_identity
    acquire_wifi_rfkill
    stop_radio_services
    phy=$(/bin/cat "$PHY_STATE")
    mac=$(/bin/cat "$MAC_STATE")
    # iwlwifi kept a firmware channel context owned by the managed wdev even
    # after changing wlan0's type. That made both DOWN-before-frequency and
    # UP-before-frequency sequences fail with EBUSY. Destroy the managed wdev
    # and create a genuine standalone monitor wdev instead. PHY/MAC identity
    # is retained in root-owned /run so `managed` can always recreate wlan0.
    /usr/bin/iw dev wlan0 del
    /usr/bin/iw phy "$phy" interface add mon0 type monitor addr "$mac"
    # The standalone iwlwifi wdev acquires its firmware channel context when
    # it becomes UP. Unlike a type-converted managed wdev, frequency selection
    # after this transition is no longer rejected as busy.
    /usr/bin/ip link set mon0 up
    /usr/bin/iw dev mon0 set freq "$frequency" "$width"
}

start_client() {
    IFS= read -r ssid
    IFS= read -r passphrase
    IFS= read -r address
    IFS= read -r frequency
    test -n "$ssid"
    test -n "$passphrase"
    /usr/bin/printf '%s\n' "$address" | /usr/bin/grep -Eq '^[0-9.]+/[0-9]+$'
    /usr/bin/printf '%s\n' "$frequency" | /usr/bin/grep -Eq '^24[0-9][0-9]$'

    take_network_manager_ownership
    remember_wifi_identity
    acquire_wifi_rfkill
    stop_radio_services
    recreate_managed_interface
    /usr/bin/ip link set wlan0 up
    /bin/mkdir -p "$STATE_DIR"
    /bin/chmod 0700 "$STATE_DIR"
    /bin/rm -rf "$WPA_CTRL"
    /bin/mkdir -m 0770 "$WPA_CTRL"
    /bin/chgrp network "$WPA_CTRL"

    # Do not place the passphrase in argv: /proc would expose it to unrelated
    # local processes. Arch's wpa_passphrase requires a terminal even when its
    # input is piped, so write the already root-owned transient profile here.
    # Rust validates both values as single-line strings before invoking us;
    # escape the two characters with syntax inside wpa_supplicant quotes.
    escaped_ssid=$(/usr/bin/printf '%s' "$ssid" | /usr/bin/sed 's/\\/\\\\/g; s/"/\\"/g')
    escaped_passphrase=$(/usr/bin/printf '%s' "$passphrase" | /usr/bin/sed 's/\\/\\\\/g; s/"/\\"/g')
    {
        # The desktop NetworkManager owns a global wpa_supplicant instance in
        # /run/wpa_supplicant. A private control directory prevents a fixture
        # epoch from colliding with that daemon's wlan0 socket while keeping
        # the system network service alive for the Ethernet uplink.
        /usr/bin/printf 'ctrl_interface=DIR=%s GROUP=network\n' "$WPA_CTRL"
        # The fixture owns exactly one managed STA. P2P creates a second wdev
        # and a second nl80211 lifecycle on the same Intel PHY; repeated AP
        # epochs then race that auxiliary interface during teardown. Keep the
        # hardware address stable so every cycle qualifies the same AP peer
        # identity instead of wpa_supplicant MAC randomization behavior.
        /usr/bin/printf 'p2p_disabled=1\n'
        /usr/bin/printf 'mac_addr=0\n'
        /usr/bin/printf 'preassoc_mac_addr=0\n'
        /usr/bin/printf 'network={\n    disabled=1\n'
        /usr/bin/printf '    ssid="%s"\n' "$escaped_ssid"
        /usr/bin/printf '    psk="%s"\n' "$escaped_passphrase"
        /usr/bin/printf '    key_mgmt=WPA-PSK\n'
        /usr/bin/printf '    proto=RSN\n'
        /usr/bin/printf '    pairwise=CCMP\n'
        # The target channel is part of the typed AP request. Restricting the
        # controlled client to that exact frequency avoids unrelated channels
        # without weakening AP discovery: the client
        # must still receive a valid beacon or probe response before joining.
        /usr/bin/printf '    scan_freq=%s\n' "$frequency"
        /usr/bin/printf '}\n'
    } >"$WPA_CONFIG"
    /bin/chmod 0600 "$WPA_CONFIG"
    /usr/bin/wpa_supplicant -B -P "$WPA_PID" -i wlan0 -c "$WPA_CONFIG"
    # The Rust owner subscribes before ENABLE_NETWORK and waits on events.
    /usr/bin/iw dev wlan0 set power_save off
    /usr/bin/ip address add "$address" dev wlan0
}

restore_managed() {
    take_network_manager_ownership
    remember_wifi_identity
    stop_radio_services
    restore_managed_interface
    /usr/bin/nmcli device set wlan0 managed yes
    restore_wifi_rfkill
}

case "$1" in
    capabilities)
        /usr/bin/printf 'schema=12 station_ap=ht20,ht40,he20 client=1 observer=20,40 managed=1 rfkill=restore\n'
        ;;
    identity)
        if test -e /sys/class/net/wlan0/phy80211; then
            /usr/bin/basename "$(/usr/bin/readlink /sys/class/net/wlan0/phy80211)"
        else
            phy=$(/bin/cat "$PHY_STATE")
            case "$phy" in phy[0-9]*) ;; *) exit 1;; esac
            test -d "/sys/class/ieee80211/$phy"
            /usr/bin/printf '%s\n' "$phy"
        fi
        ;;
    ap)
        start_ap
        ;;
    client)
        start_client
        ;;
    monitor)
        # Compatibility mode: retain an associated/AP wlan0 and add a monitor
        # view on its existing channel.
        /usr/bin/iw dev mon0 del 2>/dev/null || true
        phy=$(/usr/bin/basename "$(/usr/bin/readlink /sys/class/net/wlan0/phy80211)")
        test -n "$phy"
        /usr/bin/iw phy "$phy" interface add mon0 type monitor
        /usr/bin/ip link set mon0 up
        ;;
    monitor-1)
        start_monitor 2412 HT20
        ;;
    monitor-6)
        start_monitor 2437 HT20
        ;;
    monitor-11)
        start_monitor 2462 HT20
        ;;
    observer)
        IFS=' ' read -r frequency width extra
        test -z "$extra"
        case "$frequency" in 24[1-6][27]|2472) ;; *) usage;; esac
        case "$width" in HT20|HT40+|HT40-) ;; *) usage;; esac
        start_monitor "$frequency" "$width"
        ;;
    managed)
        restore_managed
        ;;
    stop)
        stop_radio_services
        ;;
    status)
        /usr/bin/iw dev
        /usr/bin/ip -brief address show wlan0 2>/dev/null || true
        /usr/bin/ip -brief address show mon0 2>/dev/null || true
        ;;
    usb-reset)
        /usr/bin/usbreset 303a:1001
        ;;
    kernel-log)
        /usr/bin/journalctl --dmesg --no-pager --lines=300
        ;;
    *)
        usage
        ;;
esac
