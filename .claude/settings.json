{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/observers/*.json)",
      "Read(**/target/*/deps/**)",
      "Read(**/target/*/build/**)",
      "Read(**/target/*/incremental/**)",
      "Read(**/target/*/.fingerprint/**)",
      "Read(**/target/*/*/deps/**)",
      "Read(**/target/*/*/build/**)",
      "Read(**/target/*/*/incremental/**)",
      "Read(**/target/*/*/.fingerprint/**)",
      "Read(**/target/doc/**)",
      "Read(**/target/*/doc/**)",
      "Read(**/target/vendor/**)",
      "Read(**/target/firmware/**/*.elf)",
      "Read(**/target/firmware/**/*.bin)"
    ],
    "allow": [
      "Bash(cargo tidy workspaces)",
      "Bash(cargo tidy workspaces --json)",
      "Bash(cargo tidy chips)",
      "Bash(cargo tidy chips --json)",
      "Bash(cargo stand queue)",
      "Bash(cargo stand queue --json)",
      "Bash(cargo hil scenario list)",
      "Bash(cargo hil images check --list)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
