# Infrastructure-STA Authentication/Association management-state boundary.
# The vendor root mixes this protocol slice with private interface/node state,
# NVS, power/coexistence, mesh, logging and the OSI callback table. The Rust
# replacement retains only typed protocol state and caller/Embassy services.
default-disposition not-yet-ported
default-protocol wifi

function libnet80211 ieee80211_sta_new_state
disposition replaced-by-composition
protocol wifi
rust-component open_esp_radio_ieee80211::station::StaAuthenticationRuntime
binding v1
rust-probe open_libnet80211_trace_sta_join_state
driver-adapter esp32s31-sta-join-state-v1
effect-contract exact-effects-v1
effect state-write 16 sta-management.sequence required
effect state-write 16 sta-authentication.attempt required
effect state-write 16 sta-association.retry-ordinal required
effect state-write 32 sta-state.deadline-ms required
effect platform-call rtos-scheduling-adapter platform-provided-service embassy-sta-state-deadline
effect platform-call debug-diagnostic allowed-omission debug-diagnostic
effect platform-call nvs-calibration-cache platform-provided-input caller-owned-sta-configuration
effect platform-provided-input caller-owned-sta-configuration required
effect platform-provided-service embassy-sta-state-deadline required
effect published-event sta-authenticated required
effect published-event sta-associated required
effect initialization-prerequisite infrastructure-sta-only required
effect initialization-prerequisite mesh-and-power-state-transitions-disabled required
