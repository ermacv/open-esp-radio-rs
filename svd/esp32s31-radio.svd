          <description>SOURCE[ROM_REV0_PHY_FREQUENCY_CHANNEL]; CONFIDENCE[instruction-exact-semantics-from-symbol]. Complete phy_bb_cbw_chan_cfg replaces the low two-bit CBW-derived field.</description>
          <addressOffset>0x7ce0</addressOffset><size>32</size><access>read-write</access>
          <fields><field><name>CBW_LOW_UNKNOWN</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth></field></fields>
        </register>
        <register>
          <name>CHANNEL_CBW_CONTROL_1</name>
          <description>SOURCE[ROM_REV0_PHY_FREQUENCY_CHANNEL]; CONFIDENCE[instruction-exact-semantics-from-symbol]. Complete phy_bb_cbw_chan_cfg performs two fresh-read CBW-derived replacements.</description>
          <addressOffset>0x7ce4</addressOffset><size>32</size><access>read-write</access>
          <fields>
