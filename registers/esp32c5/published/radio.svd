    <peripheral>
      <name>LP_AON_RADIO</name>
      <description>ESP32-C5 LP_AON field the PHY's power-detector SAR initialization drives. Other fields remain absent and are preserved by every field transaction.</description>
      <baseAddress>0x600B1000</baseAddress>
      <registers>
        <register>
          <name>SAR_CCT</name>
          <description>SAR control word.</description>
          <addressOffset>0x54</addressOffset>
