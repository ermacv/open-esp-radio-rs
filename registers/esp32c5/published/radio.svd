              <name>LOW_BYTE_UNKNOWN</name>
              <description>Low byte; meaning unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
