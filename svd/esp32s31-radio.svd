              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>END_RESULT_HIGH</name>
          <description>Second full result word returned by hal_mac_rx_get_end_info.</description>
          <addressOffset>0xC</addressOffset>
