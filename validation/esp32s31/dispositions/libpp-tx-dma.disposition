# First finite TX/DMA register slice. Indexed ordinary-queue leaves must cover
# all four logical queue selectors and their reversed physical PAC bank.
default-disposition not-yet-ported
default-protocol wifi

function libpp hal_mac_tx_set_cca
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_registers::generated::hal_mac_tx_set_cca
binding v1
rust-probe open_libpp_tx_trace_hal_mac_tx_set_cca
compare-return true
effect-contract exact-effects-v1
effect mmio-read 32 0x20104c5c required
effect mmio-write 32 0x20104c5c required

function libpp hal_mac_get_txq_in_trig_flow_state
disposition direct
protocol wifi
rust-component open_esp_radio_esp32s31_registers::generated::hal_mac_get_txq_in_trig_flow_state
binding v1
rust-probe open_libpp_tx_trace_hal_mac_get_txq_in_trig_flow_state
compare-return true
effect-contract exact-effects-v1
effect mmio-read 32 0x20104cb4 required

